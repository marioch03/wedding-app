# ==============================================================================
# Wedding App - Plantilla de Variables de Entorno (.env.example)
# ==============================================================================
# Copia este archivo como '.env' en la raíz antes de ejecutar 'docker compose up -d'
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Base de Datos (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_DB=nombre_base_de_datos
POSTGRES_USER=usuario_base_de_datos
POSTGRES_PASSWORD=tu_contrasena_segura_aqui
POSTGRES_PORT=5432

# Configuración de Backups Automáticos
BACKUP_SCHEDULE="0 3 * * *"
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
TZ=Europe/Madrid

# ------------------------------------------------------------------------------
# 2. Backend (Spring Boot)
# ------------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=prod
BACKEND_PORT=8080

# URL Issuer del Resource Server de Clerk (OAuth2 / JWT)
CLERK_ISSUER_URI=https://tu-instancia-clerk.clerk.accounts.dev

# Orígenes CORS permitidos (separados por coma)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://tu-dominio.com

# ------------------------------------------------------------------------------
# 3. Frontend (React 19 / Vite / Nginx)
# ------------------------------------------------------------------------------
FRONTEND_PORT=80

# Clave pública de Clerk para la UI (pk_test_... o pk_live_...)
VITE_CLERK_PUBLISHABLE_KEY=tu_clave_publica_de_clerk_aqui

# URL base del API para el frontend:
# - Dejar VACÍO ("") si utilizas el reverse proxy de Nginx incluido (RECOMENDADO).
# - O especificar la URL completa (ej. https://api.tu-dominio.com) si el backend está en otro servidor.
VITE_API_BASE_URL=
